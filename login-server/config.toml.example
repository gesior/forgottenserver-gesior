bind = "0.0.0.0:7173"
rsa_key_file = "../key.pem"
crypto_threads = 0
max_pending_logins = 4096
allow_otc_proxy = false
allow_haproxy = false

[server]
name = "Forgotten"
ip = "127.0.0.1"
